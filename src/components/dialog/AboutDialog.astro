---
import SimpleDialog from "./SimpleDialog.astro";
import { createReader } from "@keystatic/core/reader";
import keystaticConfig from "../../../keystatic.config";

// Read the About content managed via Keystatic (/keystatic).
// Falls back to sensible defaults if the singleton is missing so the modal
// never renders empty.
const reader = createReader(process.cwd(), keystaticConfig);
const about = await reader.singletons.about.read();

const bio = about?.bio ?? "";
const selectClients = about?.selectClients ?? "";
const selectExhibitions = about?.selectExhibitions ?? "";
const contactEmail = about?.contactEmail ?? "lucinda.burman@yahoo.co.uk";

// Split the bio into paragraphs (blank-line separated).
const bioParagraphs = bio
  .split(/\n\s*\n/)
  .map((p) => p.trim())
  .filter(Boolean);

// Exhibitions are stored one per line.
const exhibitionLines = selectExhibitions
  .split(/\n/)
  .map((line) => line.trim())
  .filter(Boolean);
---

<SimpleDialog id="about-dialog">
  {bioParagraphs.map((paragraph) => <p>{paragraph}</p>)}

  <h2>Select clients</h2>
  <p>{selectClients}</p>

  <h2>Select Exhibitions</h2>
  <p>
    {
      exhibitionLines.map((line, index) => (
        <>
          {line}
          {index < exhibitionLines.length - 1 && <br />}
        </>
      ))
    }
  </p>

  <div class="contact-info">
    <p>contact me:</p>
    <p><a href={`mailto:${contactEmail}`}>{contactEmail}</a></p>
    <p>or use the</p>
    <button type="button" class="contact-button focusable" data-dialog-trigger="contact-dialog">Contact Form</button>
  </div>
</SimpleDialog>

<style>
  .contact-button {
    background: transparent;
    color: var(--color-primary);
    border: 1px solid var(--color-primary);
    padding: var(--spacing-sm) var(--spacing-lg);
    border-radius: 2px;
    font-family: var(--font-heading);
    font-size: var(--text-base);
    cursor: pointer;
    transition: all var(--transition-fast);
    margin-top: var(--spacing-xs);
  }

  .contact-button:hover {
    background: var(--color-primary);
    color: white;
  }
</style>
